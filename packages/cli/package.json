{
  "name": "@air-jam/cli",
  "version": "0.9.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "Canonical project and operator CLI for Air Jam game development, agent sessions, and hosted releases",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vucinatim/air-jam.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/vucinatim/air-jam#readme",
  "bugs": {
    "url": "https://github.com/vucinatim/air-jam/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "airjam": "./bin/airjam.mjs"
  },
  "exports": {
    "./documentation": {
      "types": "./dist/documentation.d.ts",
      "import": "./dist/documentation.js"
    },
    "./development": {
      "types": "./dist/development.d.ts",
      "import": "./dist/development.js"
    },
    "./ai-pack": {
      "types": "./dist/ai-pack.d.ts",
      "import": "./dist/ai-pack.js"
    },
    "./scaffold": {
      "types": "./dist/scaffold.d.ts",
      "import": "./dist/scaffold.js"
    },
    "./vite-config": {
      "types": "./runtime/vite-config.d.mts",
      "import": "./runtime/vite-config.mjs"
    }
  },
  "files": [
    "bin",
    "dist",
    "runtime/vite-config.mjs",
    "runtime/vite-config.d.mts",
    "runtime/vite-https.mjs",
    "runtime/vite-https.d.mts",
    "runtime/local-network.mjs",
    "runtime/local-network.d.mts",
    "template-assets"
  ],
  "scripts": {
    "ai-pack:check": "node scripts/check-ai-pack.mjs",
    "ai-pack:manifest:generate": "node scripts/generate-ai-pack-manifest.mjs",
    "docs-pack:generate": "node scripts/generate-base-docs-pack.mjs",
    "build": "node ../../scripts/ensure-workspace-package-build.mjs @air-jam/devtools-core && node ../../scripts/ensure-workspace-package-build.mjs @air-jam/mcp-server && pnpm docs-pack:generate && pnpm ai-pack:manifest:generate && tsup && node ../../scripts/build-devtools-helpers.mjs --out-dir dist/tooling",
    "typecheck": "node ../../scripts/ensure-workspace-package-build.mjs @air-jam/devtools-core && node ../../scripts/ensure-workspace-package-build.mjs @air-jam/mcp-server && tsc --noEmit",
    "test": "node ../../scripts/ensure-workspace-package-build.mjs @air-jam/cli && node --test runtime/*.test.mjs",
    "prepublishOnly": "pnpm ai-pack:check && pnpm build",
    "prepack": "node ../../scripts/release/prepare-public-package-manifest.mjs",
    "postpack": "node ../../scripts/release/restore-public-package-manifest.mjs"
  },
  "dependencies": {
    "@air-jam/mcp-server": "workspace:^",
    "@air-jam/sdk": "workspace:^",
    "commander": "^14.0.0",
    "cross-spawn": "^7.0.6",
    "fs-extra": "^11.3.0",
    "kleur": "^4.1.5",
    "playwright-core": "^1.58.2",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.20.6",
    "yauzl": "^3.2.1",
    "yazl": "^3.3.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@air-jam/devtools-core": "workspace:^",
    "@air-jam/env": "workspace:^",
    "@types/fs-extra": "^11.0.4",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  }
}
