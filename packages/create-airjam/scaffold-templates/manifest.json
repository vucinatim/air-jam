{
  "schemaVersion": 1,
  "templates": [
    {
      "archive": "air-capture.zip",
      "manifest": {
        "scaffold": true,
        "export": {
          "exclude": [
            ".airjam",
            ".bundle-analyze",
            "dist",
            "dist-ssr",
            "node_modules",
            "coverage",
            "tsconfig.tsbuildinfo"
          ]
        },
        "id": "air-capture",
        "name": "Air Capture",
        "description": "Advanced 3D arena battler with ships, rockets, flags, physics, bots, and remote audio.",
        "category": "arcade"
      }
    },
    {
      "archive": "code-review.zip",
      "manifest": {
        "scaffold": true,
        "export": {
          "exclude": [
            ".airjam",
            ".bundle-analyze",
            ".cloudflared",
            "dist",
            "dist-ssr",
            "node_modules",
            "coverage",
            "tsconfig.tsbuildinfo",
            "sprites/export.jsx",
            "sprites/sprites.psd"
          ]
        },
        "id": "code-review",
        "name": "Code Review",
        "description": "2D team brawler with touch controls, optional tilt movement and a code-review twist.",
        "category": "arcade"
      }
    },
    {
      "archive": "last-band-standing.zip",
      "manifest": {
        "scaffold": true,
        "export": {
          "exclude": [
            ".airjam",
            ".bundle-analyze",
            ".cloudflared",
            "dist",
            "dist-ssr",
            "node_modules",
            "coverage",
            "tsconfig.tsbuildinfo"
          ]
        },
        "id": "last-band-standing",
        "name": "Last Band Standing",
        "description": "Music-quiz party game where the host plays a clip and controllers buzz in.",
        "category": "music"
      }
    },
    {
      "archive": "minimal.zip",
      "manifest": {
        "scaffold": true,
        "export": {
          "exclude": [
            ".airjam",
            "dist",
            "dist-ssr",
            "node_modules",
            "coverage",
            "tsconfig.tsbuildinfo"
          ]
        },
        "id": "minimal",
        "name": "Minimal",
        "description": "Clean-slate starter with a shared tap counter in a tiny code surface.",
        "category": "showcase"
      }
    },
    {
      "archive": "pong.zip",
      "manifest": {
        "default": true,
        "scaffold": true,
        "export": {
          "exclude": [
            ".airjam",
            "dist",
            "dist-ssr",
            "node_modules",
            "coverage",
            "tsconfig.tsbuildinfo"
          ]
        },
        "id": "pong",
        "name": "Pong",
        "description": "Basic 2D canvas starter. Team paddle game with lobby, bots, scoring, and audio.",
        "category": "arcade"
      }
    },
    {
      "archive": "the-office.zip",
      "manifest": {
        "scaffold": true,
        "export": {
          "exclude": [
            ".airjam",
            ".bundle-analyze",
            ".cloudflared",
            "dist",
            "dist-ssr",
            "node_modules",
            "coverage",
            "tsconfig.tsbuildinfo"
          ]
        },
        "id": "the-office",
        "name": "The Office",
        "description": "Workplace co-op chaos where players coordinate on pending tasks before time runs out.",
        "category": "party"
      }
    }
