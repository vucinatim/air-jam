{
  "name": "@air-jam/server",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "The Air Jam room server — rooms, seats, state and input for phone-controller multiplayer party games, over one WebSocket per device.",
  "keywords": [
    "air-jam",
    "airjam",
    "airconsole",
    "airconsole-alternative",
    "multiplayer",
    "multiplayer-server",
    "party-game",
    "party-games",
    "phone-controller",
    "websocket",
    "real-time",
    "realtime",
    "room-management",
    "game-server",
    "node",
    "game-development",
    "gamedev"
  ],
  "private": false,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vucinatim/air-jam.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/vucinatim/air-jam#readme",
  "bugs": {
    "url": "https://github.com/vucinatim/air-jam/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "air-jam-server": "./bin/air-jam-server.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./room": {
      "types": "./dist/room.d.ts",
      "import": "./dist/room.js"
    },
    "./room-server": {
      "types": "./dist/room-server.d.ts",
      "import": "./dist/room-server.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/main.ts",
    "logs:dev": "tsx scripts/dev-logs.ts",
    "start": "node ./bin/air-jam-server.mjs",
    "build": "node ../../scripts/ensure-workspace-package-build.mjs @air-jam/sdk && tsup",
    "test": "node ../../scripts/ensure-workspace-package-build.mjs @air-jam/sdk && vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "node ../../scripts/ensure-workspace-package-build.mjs @air-jam/sdk && tsc --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build",
    "prepack": "node ../../scripts/release/prepare-public-package-manifest.mjs",
    "postpack": "node ../../scripts/release/restore-public-package-manifest.mjs"
  },
  "dependencies": {
    "@air-jam/sdk": "workspace:*",
    "commander": "^14.0.0",
    "dotenv": "^17.2.3",
    "pino": "^10.3.1",
    "ws": "^8.18.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@air-jam/env": "workspace:^",
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
