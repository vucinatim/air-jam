{
  "name": "@air-jam/server",
  "version": "0.9.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "WebSocket signal server for Air Jam — rooms, presence, and input pipelines for phone-controller multiplayer party games.",
  "keywords": [
    "air-jam",
    "airjam",
    "airconsole",
    "airconsole-alternative",
    "multiplayer",
    "multiplayer-server",
    "party-game",
    "party-games",
    "phone-controller",
    "websocket",
    "socket.io",
    "real-time",
    "realtime",
    "room-management",
    "game-server",
    "node",
    "express",
    "game-development",
    "gamedev"
  ],
  "private": false,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vucinatim/air-jam.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/vucinatim/air-jam#readme",
  "bugs": {
    "url": "https://github.com/vucinatim/air-jam/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "air-jam-server": "./bin/air-jam-server.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/main.ts",
    "logs:dev": "tsx scripts/dev-logs.ts",
    "analytics:rebuild": "tsx scripts/runtime-usage-rebuild.ts",
    "start": "node ./bin/air-jam-server.mjs",
    "build": "node ../../scripts/ensure-workspace-package-build.mjs @air-jam/devtools-core && node ../../scripts/ensure-workspace-package-build.mjs @air-jam/harness && tsup",
    "test": "node ../../scripts/ensure-workspace-package-build.mjs @air-jam/devtools-core && node ../../scripts/ensure-workspace-package-build.mjs @air-jam/harness && vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "perf:sanity": "tsx scripts/perf-sanity.ts",
    "typecheck": "node ../../scripts/ensure-workspace-package-build.mjs @air-jam/devtools-core && node ../../scripts/ensure-workspace-package-build.mjs @air-jam/harness && tsc --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build",
    "prepack": "node ../../scripts/release/prepare-public-package-manifest.mjs",
    "postpack": "node ../../scripts/release/restore-public-package-manifest.mjs"
  },
  "dependencies": {
    "@air-jam/database-contract": "workspace:^",
    "@air-jam/operations-contract": "workspace:^",
    "@air-jam/sdk": "workspace:*",
    "color": "^5.0.3",
    "commander": "^14.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.7",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@air-jam/devtools-core": "workspace:^",
    "@air-jam/env": "workspace:^",
    "@air-jam/harness": "workspace:^",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/uuid": "^11.0.0",
    "socket.io-client": "^4.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
