#!/bin/bash
set -euo pipefail

# The worker supplies these per owned browser. No provider/worker credentials are
# inherited. The namespace has only loopback; a private Unix bridge is its sole
# network exit. The PID namespace owns Chrome and every bridge subprocess.
: "${AIRJAM_CHROMIUM_EXECUTABLE:?Missing Chromium executable}"
: "${AIRJAM_EGRESS_SOCKET:?Missing egress socket}"
: "${AIRJAM_EGRESS_PORT:?Missing egress port}"

if [[ "${1:-}" != "--inside-airjam-namespace" ]]; then
  exec unshare --user --map-current-user --keep-caps --net --pid --fork \
    --kill-child=SIGKILL "$0" --inside-airjam-namespace "$@"
fi
shift

if [[ "${1:-}" != "--run-airjam-browser" ]]; then
  ip link set lo up
  exec setpriv --no-new-privs --bounding-set=-all --inh-caps=-all --ambient-caps=-all \
    "$0" --inside-airjam-namespace --run-airjam-browser "$@"
fi
shift

# Drop namespace capabilities before either long-lived child starts. These
# processes cannot add routes or interfaces. Chromium still creates its own
# nested user-namespace sandbox, as it does for an ordinary non-root launch.
socat "TCP-LISTEN:${AIRJAM_EGRESS_PORT},bind=127.0.0.1,reuseaddr,fork" \
  "UNIX-CONNECT:${AIRJAM_EGRESS_SOCKET}" 3>&- 4>&- &
bridge_pid=$!

cleanup() {
  kill "$bridge_pid" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

# Wait for the local bridge to bind. This connects only to the namespace-local
# proxy and closes immediately; it cannot choose an egress destination.
bridge_ready=false
for attempt in {1..100}; do
  if (exec 9<>"/dev/tcp/127.0.0.1/${AIRJAM_EGRESS_PORT}") 2>/dev/null; then
    bridge_ready=true
    break
  fi
  kill -0 "$bridge_pid" 2>/dev/null || exit 1
  sleep 0.01
done
[[ "$bridge_ready" == true ]] || exit 1

"$AIRJAM_CHROMIUM_EXECUTABLE" "$@" &
browser_pid=$!
wait "$browser_pid"
