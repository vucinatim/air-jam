{
  "name": "air-jam",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "airjam": {
    "workspace": {
      "cli": "scripts/repo/cli.mjs",
      "modes": [
        "standalone-dev"
      ]
    }
  },
  "scripts": {
    "repo": "node --env-file-if-exists=.env.local scripts/repo/cli.mjs",
    "dev": "node scripts/repo/cli.mjs workspace standalone:dev",
    "topology": "node scripts/repo/cli.mjs workspace topology",
    "status": "node scripts/ensure-workspace-package-build.mjs @air-jam/cli && pnpm exec airjam status --dir .",
    "reset:local": "node scripts/ensure-workspace-package-build.mjs @air-jam/cli && pnpm exec airjam reset local --dir .",
    "mcp": "node scripts/run-repo-mcp.mjs",
    "secure:init": "node scripts/repo/cli.mjs workspace secure:init",
    "logs": "node scripts/repo/cli.mjs workspace logs",
    "release:public": "node scripts/repo/cli.mjs release trigger --channel latest",
    "release:public:next": "node scripts/repo/cli.mjs release trigger --channel next",
    "build": "pnpm -r build",
    "check:instant": "node scripts/repo/cli.mjs check instant",
    "check:changed": "node scripts/repo/cli.mjs check changed",
    "check:batch": "node scripts/repo/cli.mjs check batch",
    "check:ci": "pnpm check:batch && pnpm build && pnpm run repo -- perf sanity --profile ci",
    "check:release": "pnpm typecheck && pnpm test && pnpm build && pnpm run repo -- perf sanity --profile release && pnpm smoke:release",
    "check:release:doctor": "pnpm install --frozen-lockfile && pnpm check:release",
    "check:release:publish": "pnpm test:repo-contracts && pnpm typecheck && pnpm smoke:server",
    "lint": "eslint .",
    "guard:canonical": "node scripts/repo/cli.mjs standards canonical",
    "smoke:server": "pnpm --filter @air-jam/server test -- --run tests/game-lifecycle.integration.test.ts tests/routing-security.integration.test.ts",
    "playwright:install": "playwright install --with-deps chromium",
    "smoke:release": "pnpm smoke:server && pnpm test:scaffold",
    "test": "pnpm test:repo-contracts && pnpm --filter @air-jam/env test && pnpm --filter @air-jam/harness test && pnpm --filter @air-jam/devtools-core test && pnpm --filter @air-jam/mcp-server test && pnpm --filter @air-jam/cli test && pnpm --filter @air-jam/server test && pnpm --filter @air-jam/sdk test && pnpm --filter create-airjam test && pnpm --workspace-concurrency=2 --filter \"./games/*\" --if-present run test --maxWorkers=2",
    "test:repo-contracts": "node scripts/ensure-workspace-package-build.mjs @air-jam/sdk && node --test scripts/repo/runtime/*.test.mjs",
    "test:scaffold": "pnpm --filter create-airjam build && pnpm --filter create-airjam smoke",
    "test:scaffold:registry": "pnpm --filter create-airjam build && pnpm --filter create-airjam smoke:registry",
    "test:scaffold:tarball": "pnpm --filter create-airjam build && pnpm --filter create-airjam smoke:tarball",
    "typecheck": "pnpm --filter sdk build && pnpm -r --filter \"!sdk\" typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@air-jam/cli": "workspace:^",
    "@air-jam/harness": "workspace:^",
    "@air-jam/mcp-server": "workspace:^",
    "@air-jam/sdk": "workspace:^",
    "@air-jam/server": "workspace:^",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "commander": "^14.0.0",
    "cross-spawn": "^7.0.6",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "verdaccio": "6.2.4",
    "yaml": "^2.4.2"
  },
  "pnpm": {
    "patchedDependencies": {
      "tsup@8.5.1": "patches/tsup@8.5.1.patch"
    }
  }
}
